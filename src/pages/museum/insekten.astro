---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import EntityCard from '../../components/EntityCard.astro';
import CaughtBootstrap from '../../components/CaughtBootstrap.astro';
import { getCreatures, DEFAULT_DIRECTUS } from '../../lib/api.js';
import creaturesFallback from '../../data/creatures.json';

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL || DEFAULT_DIRECTUS;
const creatures = (await getCreatures(directusUrl, creaturesFallback)).filter((c) => c.category === 'insect');
---
<Layout title="Insektenausstellung - Eugens Museum">
  <PageHero accent="insect" emoji="🦋" title="Insektenausstellung" subtitle="Erkunde das friedliche Schmetterlingshaus und die feuchtwarmen Käfer-Gehege." />
  <p class="museum-progress" data-collection-total={creatures.length}>
    Du hast <strong><span data-collection-count="caught">0</span> von <span data-collection-count="total">{creatures.length}</span></strong> Insekten gefangen · <a href="/sammlung/">Was fehlt noch?</a>
  </p>
  <div class="grid-auto" style="--min: 180px; margin-bottom: var(--sp-12);">
    {creatures.map((c) => (
      <EntityCard creatureId={c.id} href={`/tier/${c.id}/`} image={c.image_path} title={c.name} subtitle={`📍 ${c.location_name || 'Bäume'}`} price={c.price} accent="insect" />
    ))}
  </div>
  <CaughtBootstrap />
</Layout>

<script>
  import '../../scripts/collection-ui.js';
</script>
