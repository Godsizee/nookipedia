---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import InfoBox from '../components/InfoBox.astro';
import CreatureCard from '../components/CreatureCard.astro';
import CaughtBootstrap from '../components/CaughtBootstrap.astro';
import { getCreatures, DEFAULT_DIRECTUS } from '../lib/api.js';
import { getImageUrl } from '../lib/format.js';
import creaturesFallback from '../data/creatures.json';

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL || DEFAULT_DIRECTUS;
const creatures = await getCreatures(directusUrl, creaturesFallback);

const fishList = creatures.filter((c) => c.category === 'fish');
const insectList = creatures.filter((c) => c.category === 'insect');
const seaList = creatures.filter((c) => c.category === 'sea');

const tabs = [
  { key: 'fish',   emoji: '🐟', label: 'Fische',      list: fishList },
  { key: 'insect', emoji: '🦋', label: 'Insekten',    list: insectList },
  { key: 'sea',    emoji: '🐙', label: 'Meerestiere', list: seaList },
];

// Full month names for the catch planner (month + hour query)
const MONTHS_LONG = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];

const fishTips = [
  { title: '🎣 Der Köder-Trick', text: 'Aus am Strand ausgegrabenen Teppichmuscheln bastelst du pro Muschel einen Köder. Köder garantieren einen passenden Fisch und schließen Müll komplett aus!' },
  { title: '♻️ Müll-Recycling', text: 'Ohne Köder angelst du manchmal Steine, Stiefel, Dosen oder Reifen. Kein Grund zum Ärgern: Damit schaltest du eigene Bastelanleitungen frei.' },
];
const insectTips = [
  { title: '🏡 Deko-Tipp', text: 'Gefangene Insekten lassen sich in schicken Tierbehältnissen überall im Haus oder auf der Insel ausstellen.' },
  { title: '⛈️ Gut zu wissen', text: 'Bei Regen verkriechen sich die meisten Insekten. Lifehack: Ein Gebäude betreten und wieder verlassen lädt die Insekten draußen neu. Happy Bug Catching!' },
];
const seaTips = [
  { title: '🤿 Anschleichen für Profis', text: 'Schleiche dich an schnelle Meerestiere an, indem du nur sanft mit dem linken Stick schwimmst (ohne A). Direkt über dem Tier (an Blasen erkennbar) tauchst du es.' },
  { title: '⚠️ Modell-Einschränkung', text: 'Meerestiere kannst du ausstellen, aber – anders als bei Insekten und Fischen – keine Modelle bei Lomeus oder Carlson in Auftrag geben.' },
];
---

<Layout title="Faunapädie - Insekten, Fische & Meerestiere">
  <PageHero accent="insect" emoji="🐾" title="Faunapädie" subtitle="Alle Details zu den faszinierenden Kreaturen deiner Insel." />

  <!-- Category tabs · sticky rail with live counts (re-theme per category) -->
  <div class="fauna-tabs">
    {tabs.map((t, i) => (
      <button class={`tab-btn accent-${t.key} ${i === 0 ? 'active' : ''}`} data-tab={t.key}>
        <span>{t.emoji}</span> {t.label} <span class="count">{t.list.length}</span>
      </button>
    ))}
  </div>

  <!-- Collection progress · entry point into the Sammlung module -->
  <div class="fauna-progress" data-collection-total={creatures.length}>
    <div class="fauna-progress__meter" data-collection-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Sammlungsfortschritt"><span></span></div>
    <p class="fauna-progress__text">
      <strong><span data-collection-count="caught">0</span> / {creatures.length}</strong> gefangen ·
      noch <strong><span data-collection-count="missing">{creatures.length}</span></strong> offen
    </p>
    <a href="/sammlung/" class="ac-btn">🎣 Meine Sammlung</a>
  </div>

  <!-- Tab-specific intro + tips -->
  <InfoBox id="info-fish" accent="fish" emoji="🐟" title="Petri Heil!" tips={fishTips}>
    <p>Vollständige Übersicht aller {fishList.length} Fische. Zücke deine <strong>Angel</strong> – aber renne nicht direkt ans Wasser, sonst verscheuchst du deine Beute!</p>
  </InfoBox>
  <InfoBox id="info-insect" accent="insect" emoji="🦋" title="Die Welt der Insekten" tips={insectTips} hidden>
    <p>Vollständige Übersicht aller {insectList.length} Insekten. Schnapp dir deinen <strong>Kescher</strong> und los geht's!</p>
  </InfoBox>
  <InfoBox id="info-sea" accent="sea" emoji="🐙" title="Ab ins kühle Nass!" tips={seaTips} hidden>
    <p>Vollständige Übersicht aller {seaList.length} Meerestiere. Zum Tauchen brauchst du einen <strong>Taucheranzug</strong>.</p>
  </InfoBox>

  <!-- Search + filter bar -->
  <div class="filter-bar mb-6">
    <input type="search" id="fauna-search" class="ac-input" placeholder="🔎 Kreatur suchen…" autocomplete="off" />
    <div class="cluster">
      <label class="ac-checkbox"><input type="checkbox" id="filter-month" /> 📅 Diesen Monat</label>
      <label class="ac-checkbox"><input type="checkbox" id="filter-now" /> ⏰ Jetzt fangbar</label>
    </div>
    <div class="seg" role="group" aria-label="Nach Sammlungsstand filtern">
      <button type="button" class="seg-btn active" data-collection-filter="all">Alle</button>
      <button type="button" class="seg-btn" data-collection-filter="missing">🎯 Fehlend</button>
      <button type="button" class="seg-btn" data-collection-filter="caught">✅ Gefangen</button>
    </div>
    <button id="clear-filters" class="ac-btn">🧹 Zurücksetzen</button>
  </div>

  <!-- Catch planner · query catchability for any chosen month & hour -->
  <div class="filter-bar planner-bar mb-6">
    <span class="planner-label">🔮 Fang-Planer</span>
    <label class="planner-field">
      <span>📅 Monat</span>
      <select id="plan-month" class="ac-input">
        <option value="">— egal —</option>
        {MONTHS_LONG.map((m, i) => <option value={i + 1}>{m}</option>)}
      </select>
    </label>
    <label class="planner-field">
      <span>⏰ Uhrzeit</span>
      <select id="plan-hour" class="ac-input">
        <option value="">— egal —</option>
        {Array.from({ length: 24 }, (_, h) => <option value={h}>{String(h).padStart(2, '0')}:00 Uhr</option>)}
      </select>
    </label>
    <button type="button" id="hemisphere-toggle" class="ac-btn" title="Zwischen Nord- und Südhalbkugel umschalten">🌍 Nord</button>
    <span class="planner-hint" id="plan-hint"></span>
  </div>

  <!-- Quick-nav mini grids -->
  <div class="ac-card mb-8">
    {tabs.map((t, i) => (
      <div class={`mini-grid-wrap accent-${t.key} ${i === 0 ? '' : 'hide'}`} id={`mini-grid-${t.key}`}>
        <div class="mini-grid-head"><span>{t.emoji}</span> Schnellauswahl · {t.label}</div>
        <div class="mini-grid">
          {t.list.map((c) => (
            <a href={`#creature-${c.id}`} class="mini-card" data-id={c.id} data-creature-id={c.id} data-name={(c.name || '').toLowerCase()} data-months={c.months_northern ? c.months_northern.join(',') : ''} data-time={c.time_active || ''} data-time-segments={c.time_segments ? JSON.stringify(c.time_segments) : undefined} title={c.name}>
              <img src={getImageUrl(c.image_path)} alt={c.name} loading="lazy" onerror="this.src='/assets/img/acnh/koeder.png'" />
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Detail cards -->
  <h2 class="section-title">📋 Kreaturen-Akten</h2>
  <p class="result-count">Zeige <b id="result-num">0</b> Kreaturen</p>
  <div class="creature-grid">
    {creatures.map((c) => <CreatureCard creature={c} />)}
  </div>

  <div id="empty-state" class="empty-state hide mt-8">
    <span class="emoji">🏜️</span>
    Keine Kreaturen erfüllen diese Filterkriterien…
  </div>

  <CaughtBootstrap />
</Layout>

<script>
  // Catch-window maths and the catch log both come from shared modules, so this
  // page, the detail page and /sammlung/ can never disagree about a creature.
  import { MONTHS_LONG, isCatchableNow as isCatchable, isActiveAt, isActiveAtAnyMonth, isAvailableInMonth, monthsFor } from '../lib/catch-window.js';
  import { isCaught, subscribe, getHemisphere, setHemisphere, toggle } from '../lib/collection.js';
  import { showToast } from '../scripts/collection-ui.js';
  import { initLocationPopover } from '../scripts/location-popover.js';

  const CAT_LABEL = { fish: 'Fische', insect: 'Insekten', sea: 'Meerestiere' };

  /** Repaint a card's month calendar for the active hemisphere. */
  function paintMonthGrid(card, months) {
    const boxes = card.querySelectorAll('.month-box');
    boxes.forEach((box, index) => {
      const active = months.includes(index + 1);
      box.classList.toggle('active', active);
      box.classList.toggle('inactive', !active);
    });
  }

  // Held across View-Transition swaps so a re-init never stacks subscriptions
  // on top of the previous page's (detached) DOM.
  let unsubscribe = null;

  function initFaunapedia() {
    if (unsubscribe) { unsubscribe(); unsubscribe = null; }
    const tabs = document.querySelectorAll('.tab-btn');
    const infoBoxes = document.querySelectorAll('.info-box');
    const miniGrids = document.querySelectorAll('.mini-grid-wrap');
    const creatureCards = document.querySelectorAll('.creature-card');
    const filterMonth = document.getElementById('filter-month');
    const filterNow = document.getElementById('filter-now');
    const search = document.getElementById('fauna-search');
    const resultNum = document.getElementById('result-num');
    const btnClear = document.getElementById('clear-filters');
    const emptyState = document.getElementById('empty-state');
    const planMonth = document.getElementById('plan-month');
    const planHour = document.getElementById('plan-hour');
    const planHint = document.getElementById('plan-hint');
    const segButtons = document.querySelectorAll('[data-collection-filter]');
    const hemisphereBtn = document.getElementById('hemisphere-toggle');
    if (!tabs.length || !filterMonth) return;

    // 'all' | 'missing' | 'caught' — global, not per category
    let collectionFilter = localStorage.getItem('nook_collection_filter') || 'all';

    // Restore planner selection (global across categories)
    if (planMonth) planMonth.value = localStorage.getItem('nook_plan_month') || '';
    if (planHour) planHour.value = localStorage.getItem('nook_plan_hour') || '';

    let activeCategory = localStorage.getItem('nook_active_faunapedia_tab') || 'fish';

    function applyFilters() {
      const now = new Date();
      const currentMonth = now.getMonth() + 1;
      const currentHour = now.getHours();
      const term = (search.value || '').trim().toLowerCase();
      localStorage.setItem(`nook_filter_${activeCategory}_month`, filterMonth.checked);
      localStorage.setItem(`nook_filter_${activeCategory}_now`, filterNow.checked);

      // Planner query: chosen month / hour ('' = egal → null = ignored)
      const qMonth = planMonth && planMonth.value !== '' ? parseInt(planMonth.value, 10) : null;
      const qHour = planHour && planHour.value !== '' ? parseInt(planHour.value, 10) : null;
      const planActive = qMonth !== null || qHour !== null;
      localStorage.setItem('nook_plan_month', planMonth ? planMonth.value : '');
      localStorage.setItem('nook_plan_hour', planHour ? planHour.value : '');

      const hemisphere = getHemisphere();
      if (hemisphereBtn) hemisphereBtn.textContent = hemisphere === 'south' ? '🌍 Süd' : '🌍 Nord';

      let visibleCount = 0;
      creatureCards.forEach((card) => {
        if (card.dataset.category !== activeCategory) { card.style.display = 'none'; return; }

        const creatureMock = {
          months_northern: card.dataset.months ? card.dataset.months.split(',').map(Number) : [],
          time_active: card.dataset.time || '',
          time_segments: card.dataset.timeSegments ? JSON.parse(card.dataset.timeSegments) : null
        };
        const months = monthsFor(creatureMock, hemisphere);
        paintMonthGrid(card, months);
        const liveNow = isCatchable(creatureMock, now, hemisphere);
        card.classList.toggle('is-now', liveNow);

        const caught = isCaught(card.dataset.creatureId);

        let visible = true;
        if (term && !(card.dataset.name || '').includes(term)) visible = false;
        if (visible && filterMonth.checked && !isAvailableInMonth(creatureMock, currentMonth, hemisphere)) visible = false;
        if (visible && filterNow.checked && !liveNow) visible = false;
        if (visible && planActive) {
          if (qMonth !== null && !isAvailableInMonth(creatureMock, qMonth, hemisphere)) visible = false;
          if (qHour !== null) {
            if (qMonth !== null) {
              if (!isActiveAt(creatureMock, qMonth, qHour, hemisphere)) visible = false;
            } else {
              if (!isActiveAtAnyMonth(creatureMock, qHour, hemisphere)) visible = false;
            }
          }
        }
        if (visible && collectionFilter === 'missing' && caught) visible = false;
        if (visible && collectionFilter === 'caught' && !caught) visible = false;

        const mCard = document.querySelector(`.mini-card[data-id="${card.id.split('-')[1]}"]`);
        if (mCard) { mCard.classList.toggle('faded', !visible); mCard.classList.toggle('is-now', liveNow); }
        card.style.display = visible ? 'flex' : 'none';
        if (visible) visibleCount++;
      });

      if (resultNum) resultNum.textContent = visibleCount;
      emptyState.classList.toggle('hide', visibleCount !== 0);

      // Plain-language summary of the active planner query
      if (planHint) {
        const cat = CAT_LABEL[activeCategory] || 'Kreaturen';
        let msg = '';
        if (qMonth !== null && qHour !== null) {
          msg = `Zeigt ${cat}, die im ${MONTHS_LONG[qMonth - 1]} um ${String(qHour).padStart(2, '0')}:00 Uhr fangbar sind.`;
        } else if (qMonth !== null) {
          msg = `Zeigt ${cat}, die im ${MONTHS_LONG[qMonth - 1]} fangbar sind.`;
        } else if (qHour !== null) {
          msg = `Zeigt ${cat}, die um ${String(qHour).padStart(2, '0')}:00 Uhr fangbar sind.`;
        }
        planHint.textContent = msg;
        planHint.classList.toggle('hide', !msg);
      }
    }

    function switchTab(category) {
      activeCategory = category;
      localStorage.setItem('nook_active_faunapedia_tab', category);
      tabs.forEach((b) => b.classList.toggle('active', b.dataset.tab === category));
      infoBoxes.forEach((box) => box.classList.toggle('hide', box.id !== `info-${category}`));
      miniGrids.forEach((g) => g.classList.toggle('hide', g.id !== `mini-grid-${category}`));
      filterMonth.checked = localStorage.getItem(`nook_filter_${category}_month`) === 'true';
      filterNow.checked = localStorage.getItem(`nook_filter_${category}_now`) === 'true';
      applyFilters();
    }

    tabs.forEach((b) => b.addEventListener('click', () => switchTab(b.dataset.tab)));
    filterMonth.addEventListener('change', applyFilters);
    filterNow.addEventListener('change', applyFilters);
    search.addEventListener('input', applyFilters);
    if (planMonth) planMonth.addEventListener('change', applyFilters);
    if (planHour) planHour.addEventListener('change', applyFilters);
    btnClear.addEventListener('click', () => {
      filterMonth.checked = false; filterNow.checked = false; search.value = '';
      if (planMonth) planMonth.value = '';
      if (planHour) planHour.value = '';
      setCollectionFilter('all');
    });

    function setCollectionFilter(mode) {
      collectionFilter = mode;
      localStorage.setItem('nook_collection_filter', mode);
      segButtons.forEach((b) => b.classList.toggle('active', b.dataset.collectionFilter === mode));
      applyFilters();
    }
    segButtons.forEach((b) => b.addEventListener('click', () => setCollectionFilter(b.dataset.collectionFilter)));
    setCollectionFilter(collectionFilter);

    hemisphereBtn?.addEventListener('click', () => {
      setHemisphere(getHemisphere() === 'south' ? 'north' : 'south');
      applyFilters();
    });

    // Re-filter whenever a creature is ticked off — cards leave the list live.
    unsubscribe = subscribe(applyFilters);

    // Long-press a quick-select tile to tick it off — turns the first-time
    // setup from 200 taps into a few seconds of thumb work.
    document.querySelectorAll('.mini-card').forEach((card) => {
      let pressTimer = null;
      let longPressed = false;

      const startPress = () => {
        longPressed = false;
        clearTimeout(pressTimer);
        pressTimer = setTimeout(() => {
          longPressed = true;
          const { caught, undo } = toggle(card.dataset.creatureId);
          navigator.vibrate?.(15);
          showToast(`${card.getAttribute('title') || 'Kreatur'} ${caught ? 'eingetragen' : 'wieder offen'}`, undo);
        }, 450);
      };
      const cancelPress = () => clearTimeout(pressTimer);

      card.addEventListener('pointerdown', startPress);
      card.addEventListener('pointerup', cancelPress);
      card.addEventListener('pointerleave', cancelPress);
      card.addEventListener('pointercancel', cancelPress);
      card.addEventListener('contextmenu', (e) => { if (longPressed) e.preventDefault(); });

      card.addEventListener('click', (e) => {
        if (longPressed) { e.preventDefault(); longPressed = false; return; }
        const href = card.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        e.preventDefault();
        const target = document.getElementById(href.substring(1));
        if (!target) return;
        const offset = target.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top: offset, behavior: 'smooth' });
        target.style.transition = 'transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease';
        target.style.transform = 'scale(1.03)';
        target.style.borderColor = 'var(--accent)';
        setTimeout(() => { target.style.transform = ''; target.style.borderColor = ''; }, 1200);
      });
    });

    switchTab(activeCategory);
    initLocationPopover();
  }

  initFaunapedia();
  document.addEventListener('astro:after-swap', initFaunapedia);
</script>
