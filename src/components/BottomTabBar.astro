---
// BottomTabBar.astro · mobile app navigation (shown < 960px).
// Rendered from the same `navItems` source as the desktop nav (passed in
// from Layout) so both navigations stay in sync — apart from entries the
// Layout marks `mobileOnly`, which only this bar shows. Uses the compact
// `short` label; beyond seven sections the bar scrolls horizontally rather
// than squeezing the labels into unreadable stumps.
interface NavItem {
  href: string;
  emoji: string;
  short: string;
  active: boolean;
}
const { items = [] as NavItem[] } = Astro.props;
---
<nav class="bottom-tab-bar" aria-label="Mobile App Navigation">
    {items.map((item: NavItem) => (
        <a href={item.href} class={`bottom-tab-item ${item.active ? 'active' : ''}`} title={item.short}>
            <span aria-hidden="true">{item.emoji}</span>
            <span class="bottom-tab-label">{item.short}</span>
        </a>
    ))}
</nav>
<script is:inline>
  // With more tabs than fit, make sure the current section is the one in view.
  (function () {
    var bar = document.querySelector('.bottom-tab-bar');
    var active = bar && bar.querySelector('.bottom-tab-item.active');
    if (!active) return;
    bar.scrollLeft = Math.max(0, active.offsetLeft - (bar.clientWidth - active.clientWidth) / 2);
  })();
</script>
