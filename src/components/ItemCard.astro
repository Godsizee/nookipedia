---
/**
 * ItemCard · Katalog-Kachel im Inventar-Look (Bild-Well + Name + Preis).
 *
 * SRP: reine Darstellung. Alle Filter-/Sortier-Metadaten hängen als `data-*`
 * am Wurzel-Link, damit die Katalog-Steuerung ohne zweiten Datensatz auskommt.
 */
import { getImageUrl } from '../lib/format.js';

interface Props {
  id: number | string;
  name: string;
  nameEn?: string | null;
  image?: string | null;
  category: string;
  categoryLabel: string;
  categoryEmoji: string;
  family: string;
  price?: number | null;
  variants?: number;
  meta?: string | null;
  diy?: boolean;
  customizable?: boolean;
  /** Serverseitig ausgeblendet (Seitenweise-Anzeige); JS blendet bei Bedarf ein. */
  hidden?: boolean;
}
const {
  id, name, nameEn, image, category, categoryLabel, categoryEmoji, family,
  price = null, variants = 1, meta = null, diy = false, customizable = false,
  hidden = false,
} = Astro.props;

const flags = [diy && 'diy', customizable && 'custom', variants > 1 && 'variants']
  .filter(Boolean)
  .join(' ');
const priceLabel = price ? new Intl.NumberFormat('de-DE').format(price) : null;
---
<a
  class:list={['item-tile', hidden && 'hide']}
  href={`/items/${id}/`}
  title={name}
  data-search={`${name} ${nameEn || ''}`.toLowerCase()}
  data-name={name.toLowerCase()}
  data-cat={category}
  data-fam={family}
  data-price={price || 0}
  data-variants={variants}
  data-flags={flags}
>
  <span class="item-tile__well">
    <img
      src={getImageUrl(image, { fallback: '/assets/img/acnh/placeholder.png' })}
      alt={name}
      loading="lazy"
      decoding="async"
      onerror="this.src='/assets/img/acnh/placeholder.png'"
    />
    <span class="item-tile__cat" title={categoryLabel} aria-hidden="true">{categoryEmoji}</span>
    {(diy || customizable) && (
      <span class="item-tile__flags">
        {diy && <span class="item-tile__flag" title="Selbst herstellbar">🔨</span>}
        {customizable && <span class="item-tile__flag" title="Umgestaltbar">🎨</span>}
      </span>
    )}
    {variants > 1 && <span class="item-tile__variants">🌈 {variants}</span>}
  </span>

  <strong class="item-tile__name">{name}</strong>
  {meta && <span class="item-tile__meta muted">{meta}</span>}
  <span class="item-tile__foot">
    {priceLabel
      ? <span class="price-tag">💰 {priceLabel}</span>
      : <span class="item-tile__noprice muted">unverkäuflich</span>}
  </span>
</a>

<style>
  .item-tile {
    /* Kacheln außerhalb des Viewports kosten kein Layout — wichtig bei
       mehreren tausend Katalog-Einträgen. */
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-3) var(--sp-3) var(--sp-4);
    text-align: center;
    text-decoration: none;
    color: var(--ac-text);
    background: var(--ac-surface);
    border: 1px solid var(--ac-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--ac-shadow-sm);
    transition: transform var(--t-base) var(--ease-spring), border-color var(--t-base), box-shadow var(--t-base);
  }
  .item-tile:hover,
  .item-tile:focus-visible {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--ac-border));
    box-shadow: var(--ac-shadow-lg);
  }
  .item-tile:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .item-tile:active { transform: translateY(-2px) scale(0.98); }

  /* — Bild-Well: die Inventar-Zelle aus dem Spiel — */
  .item-tile__well {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    padding: 14px;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 50% 8%, color-mix(in srgb, var(--accent) 13%, var(--ac-surface-2)) 0%, var(--ac-surface-2) 62%);
    border-radius: var(--radius-md);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.07);
  }
  .item-tile__well img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.16));
    transition: transform var(--t-base) var(--ease-spring);
  }
  .item-tile:hover .item-tile__well img { transform: scale(1.1) rotate(-2deg); }

  /* Glanz-Sweep beim Hover (nur transform → günstig). */
  .item-tile__well::after {
    content: '';
    position: absolute;
    inset: -40% -70%;
    background: linear-gradient(105deg, transparent 42%, var(--ac-sheen) 50%, transparent 58%);
    transform: translateX(-130%);
    pointer-events: none;
  }
  .item-tile:hover .item-tile__well::after { transition: transform 0.75s var(--ease-soft); transform: translateX(130%); }

  /* — Marker im Well — */
  .item-tile__cat {
    position: absolute; top: 6px; left: 6px;
    display: grid; place-items: center;
    width: 26px; height: 26px;
    font-size: 0.8rem; line-height: 1;
    background: color-mix(in srgb, var(--ac-surface) 88%, transparent);
    border-radius: var(--radius-pill);
    box-shadow: var(--ac-shadow-sm);
  }
  .item-tile__flags { position: absolute; top: 6px; right: 6px; display: flex; gap: 3px; }
  .item-tile__flag {
    display: grid; place-items: center;
    width: 24px; height: 24px;
    font-size: 0.72rem; line-height: 1;
    background: var(--ac-surface);
    border: 2px solid var(--accent);
    border-radius: 50%;
    box-shadow: var(--ac-shadow-sm);
  }
  .item-tile__variants {
    position: absolute; left: 6px; bottom: 6px;
    padding: 0.16rem 0.5rem;
    font-weight: 800; font-size: 0.7rem; line-height: 1.4;
    color: var(--on-accent);
    background: color-mix(in srgb, var(--accent) 88%, transparent);
    border-radius: var(--radius-pill);
    box-shadow: var(--ac-shadow-sm);
  }

  /* — Text — */
  .item-tile__name {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 2px;
    font-family: var(--font-display); font-weight: 600; font-size: 0.94rem; line-height: 1.2;
  }
  .item-tile__meta {
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.75rem; line-height: 1.3;
  }
  .item-tile__foot { margin-top: auto; padding-top: var(--sp-2); }
  .item-tile__foot .price-tag { padding: 0.22rem 0.62rem; font-size: 0.78rem; }
  .item-tile__noprice { font-size: 0.75rem; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .item-tile, .item-tile__well img, .item-tile__well::after { transition: none !important; }
    .item-tile:hover { transform: none; }
    .item-tile:hover .item-tile__well img { transform: none; }
    .item-tile:hover .item-tile__well::after { transform: translateX(-130%); }
  }
</style>
